{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "..",
    "paths": {
      "@nfets/nfe": ["./src/index"],
      "@nfets/nfe/*": ["./src/*"],
      "@nfets/core": ["../core/src/index"],
      "@nfets/core/*": ["../core/src/*"],
      "@nfets/test/*": ["../test/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../core/src/**/*.ts",
    "../test/src/expects.ts",
    "../test/src/certificates.ts",
    "../test/src/ensure-platform.ts",
    "../test/src/ensure-integration-tests.ts"
  ]
}
