{
  "name": "nfets",
  "version": "0.0.0",
  "description": "typescript libraries for Brazilian's SEFAZ standards",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./nfe": {
      "types": "./dist/nfe/index.d.ts",
      "import": "./dist/nfe/index.mjs",
      "require": "./dist/nfe/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    }
  },
  "engines": {
    "pnpm": ">=9",
    "node": ">=22.18",
    "yarn": "use pnpm!",
    "npm": "use pnpm!"
  },
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nfets/nfets.git"
  },
  "gypfile": true,
  "files": [
    "dist",
    "build/addons",
    "addons",
    "binding.gyp",
    "packages/nfe/schemas"
  ],
  "scripts": {
    "install": "pnpm dlx node-gyp@12.1.0 rebuild || echo 'Warning: Failed to rebuild native addon. Make sure you have build tools installed (python, make, g++, and libxml2-dev on Linux).'",
    "build": "pnpm --filter !@nfets/test build && tsup --config tsup.config.ts",
    "test": "pnpm --filter @nfets/* test",
    "typecheck": "pnpm --filter @nfets/* typecheck",
    "test:coverage": "pnpm --filter @nfets/* test:coverage --coverageReporters=\"json-summary\""
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sefaz",
    "nfse",
    "nfs-e",
    "nfe",
    "nf-e",
    "nfce",
    "nfc-e"
  ],
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.2",
    "esbuild": "^0.28.1",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.47",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.3",
    "@typescript-eslint/parser": "^8.66.0",
    "axios": "^1.19.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-prettier": "^5.5.6",
    "fs-extra": "^11.4.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "pdf-parse": "^2.4.5",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
